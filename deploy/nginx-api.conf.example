# Example Nginx site config for api.gofootball.ai
# Copy to /etc/nginx/sites-available/ and symlink to sites-enabled.
#
# Required for video uploads (up to 100 MB in the app).
# Without client_max_body_size, Nginx returns 413 for files over ~1 MB.

server {
    listen 443 ssl http2;
    server_name api.gofootball.ai;

    # ssl_certificate ...
    # ssl_certificate_key ...

    client_max_body_size 100M;
    client_body_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
}
