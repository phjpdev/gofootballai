# Example Nginx site config for api.gofootball.ai
# Copy to /etc/nginx/sites-available/ and symlink to sites-enabled.
#
# Required for video uploads (up to 100 MB in the app).
# Without client_max_body_size, Nginx returns 413 for files over ~1 MB.

server {
    listen 443 ssl http2;
    server_name api.gofootball.ai;

    # ssl_certificate ...
    # ssl_certificate_key ...

    client_max_body_size 100M;
    client_body_timeout 300s;

    # CRITICAL: disable etag/304 for video Range requests (304 breaks playback).
    location /uploads/ {
        alias /var/www/gofootballai/backend/uploads/;
        etag off;
        if_modified_since off;
        add_header Accept-Ranges bytes always;
        add_header Access-Control-Allow-Origin https://gofootball.ai always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;
        add_header Cross-Origin-Resource-Policy cross-origin always;
        add_header Cache-Control "public, max-age=3600" always;

        types {
            video/mp4 mp4 m4v;
            video/webm webm;
            video/quicktime mov;
            image/jpeg jpg jpeg;
            image/png png;
            image/webp webp;
            image/gif gif;
        }
        default_type application/octet-stream;
    }

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
