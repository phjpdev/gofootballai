PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gofootball_ai
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# xAI Grok (server-side only — never expose to frontend)
XAI_API_KEY=
XAI_MODEL=grok-3-fast-latest
XAI_TIMEOUT_MS=12000
ANALYSIS_PROMPT_VERSION=v1
ANALYSIS_WAIT_MS=10000
ANALYSIS_PREWARM_MAX=6
ANALYSIS_PENDING_STALE_MS=45000

# Redis hot cache (optional locally; recommended in production)
# REDIS_URL=redis://localhost:6379
ANALYSIS_QUEUE_CONCURRENCY=2

# HKJC GraphQL (server must reach info.cld.hkjc.com; use ipv4first on VPS)
# HKJC_GRAPHQL_URL=https://info.cld.hkjc.com/graphql/base/
HKJC_TIMEOUT_MS=15000
