PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gofootball_ai
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# xAI Grok (server-side only — never expose to frontend)
XAI_API_KEY=
XAI_MODEL=grok-3-fast-latest
XAI_TIMEOUT_MS=45000
XAI_MAX_RETRIES=2
ANALYSIS_PROMPT_VERSION=v1
ANALYSIS_WAIT_MS=0
ANALYSIS_PREWARM_MAX=6
ANALYSIS_PENDING_STALE_MS=90000

# Redis hot cache (optional locally; recommended in production)
# REDIS_URL=redis://localhost:6379
ANALYSIS_QUEUE_CONCURRENCY=4

# HKJC — VPS outside Hong Kong often cannot reach info.cld.hkjc.com directly.
# Use a Hong Kong proxy and set HKJC_GRAPHQL_URL to the proxy URL.
# HKJC_GRAPHQL_URL=https://your-hk-proxy.example.com/graphql/base/
HKJC_CONNECT_TIMEOUT_MS=30000
HKJC_TIMEOUT_MS=45000
HKJC_FETCH_RETRIES=3
# Pin Akamai edge IP when VPS DNS returns unreachable HKJC addresses
# HKJC_PINNED_IP=23.53.15.137
